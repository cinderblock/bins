# --- Web (dev) ---
# Vite dev server port; the dev API attaches at API_PORT and Vite proxies /api.
PORT=3000
API_PORT=3001
# Public origin the app is served from. Locally: http://localhost:3000.
# Production: your public origin, e.g. https://bins.example.org. QR codes
# carry this origin (they're generated from the page's own location).
PUBLIC_BASE_URL=http://localhost:3000

# --- Server ---
# Production only: unix socket the Bun server binds (Caddy proxies to it).
#SOCKET_PATH=/run/bins/bins.sock
# SQLite database file. Created + migrated automatically on boot.
DATABASE_PATH=./data/bins.db
# Directory for content-addressed photo blobs.
PHOTOS_PATH=./data/photos

# First-boot: no env needed — visiting the app on an empty database opens the
# /setup page (group name, landing branding, access code, admin password).
# Additional groups: bun scripts/create-group.ts

# --- Trust model ---
# Set this ONLY when the deployment sits behind a network perimeter (a LAN, a
# VPN) enforced by the reverse proxy. It removes the need for sticker secrets:
# joining takes just a display name, and allocated stickers get a bare
# `/{id}` QR instead of `/{id}#CODE`. Single-group deployments only.
#OPEN_ACCESS=1
# Backstop for a proxy misconfiguration: open joins are refused unless the
# forwarded client address is private. On by default with OPEN_ACCESS; the
# perimeter is still the proxy's job, this only stops a bad rule from being an
# instantly open door. Set to 0 for dev (no proxy sets the header) or for a
# perimeter that hands out public addresses.
#OPEN_ACCESS_REQUIRE_PRIVATE_CLIENT=0

# --- Home surface ---
# Which screen "/" opens on. Independent of the trust model above.
#   scanner (default) — the camera IS the home screen. Right when the job is
#                       "work through this pile of boxes": scan, snap, next.
#   browse            — open on the box list + search, with Scan one prominent
#                       tap away (/scan). Right for a standing warehouse, where
#                       the question is "which box is it in".
#HOME_VIEW=browse

# --- Box numbers ---
# Is the box number meaningful to the people using this deployment?
#   public (default) — printed on the container, said out loud ("grab bin 47").
#                      It leads the UI.
#   internal         — containers get relabeled and reused, so the id is just a
#                      URL handle; the box's NAME leads instead and the number
#                      is a quiet fallback for boxes not yet named.
# Presentation only — ids stay integers from one monotonic sequence either way,
# which is what guarantees they're never reused (so a leftover sticker always
# resolves to its own dead record, never to someone else's inventory).
#BOX_NUMBERS=internal

# --- Label printing ---
# A service that accepts a LABEL SPEC (JSON: title, url, lines, copies) and
# prints it. Unset = no "Label" button; the sticker-code export stays the only
# path, which is what pre-printed-sticker operators use.
# The repo stays printer-agnostic on purpose: media size, layout, artwork,
# dithering and printer command language all live behind this URL.
#LABEL_PRINT_URL=http://labelpi/api/label
# Optional bearer. Server-side only — never sent to a browser.
#LABEL_PRINT_TOKEN=

# --- Label art (optional) ---
# Generated black-and-white line art for labels. Entirely optional: with no key
# set, labels render as text + QR and nothing calls out to anyone. This is the
# only part of the system that spends real money per action.
#LABEL_ART_API_KEY=
# Default: gemini-2.5-flash-image ($0.039/image). Also priced:
# gemini-3-pro-image-preview ($0.134), imagen-4.0-generate-001 ($0.04),
# imagen-4.0-ultra-generate-001 ($0.06).
#LABEL_ART_MODEL=gemini-2.5-flash-image
# Monthly ceiling in USD. Unset means NO ceiling — set one deliberately.
# Checked before each call; images already generated are always reusable.
#LABEL_ART_BUDGET_USD=5.00
# Where generated art is cached (keyed by model+prompt, so regenerating the
# same box is free). Defaults to a sibling of PHOTOS_PATH.
#LABEL_ART_PATH=./data/art
